# Copy to .env and fill in secrets. Never commit .env.

LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://llm.gisul.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

STT_PROVIDER=whisper_api
GROQ_API_KEY=
STT_API_KEY=
STT_WHISPER_MODEL=whisper-large-v3

TTS_URL=https://tts.gisul.ai/synthesize
TTS_VOICE=af_heart

# LiveKit (STT/camera only). Never put the secret in the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HTTP_URL=

USE_REDIS=true
REDIS_URL=redis://localhost:6379/0

# Optional. When set, all /api/* except /api/health and /api/ready require this key.
INTERVIEW_API_KEY=

# Comma-separated origins. Use * only for local demos.
ALLOWED_ORIGINS=*

MAX_UPLOAD_MB=8
UVICORN_RELOAD=true
